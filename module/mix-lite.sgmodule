# ==============================
# [Body Rewrite]
# ==============================
[Body Rewrite]

# --- Bilibili ---
http-response-jq ^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? '.data[][]?="stun.chat.bilibili.com:3478"'
# NOTE: This rewrite removes payment metadata and is not ad-only behavior.
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'

# --- Xianyu ---
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade\/ 'del(.data)'
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list\/ 'del(.data)'

# --- WeChat ---
http-response ^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad advertisement fmz200

# --- Qishui Music ---
http-response-jq ^https:\/\/beta-luna\.douyin\.com\/luna\/card\? 'if (.card_items? | type == "array") then (.card_items |= map(if ((has("is_ad") and (.is_ad == true)) or has("ad_type") or has("ad_info") or has("ad_data")) then ((if has("priority_display") then .priority_display = false else . end) | (if has("is_show") then .is_show = false else . end)) else . end)) else . end'
http-response-jq ^https:\/\/beta-luna\.douyin\.com\/luna\/card\? 'if has("preview_guide") then .preview_guide = null else . end'
http-response-jq ^https:\/\/beta-luna\.douyin\.com\/luna\/more-panel\? 'if (.blocks? | type == "array") then (.blocks |= map(select(((has("is_ad") and (.is_ad == true)) or has("ad_type") or has("ad_info") or has("ad_data")) | not))) else . end'


